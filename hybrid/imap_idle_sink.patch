+        // Baseline the wake flag for this Ping. ChangesSink() creates
+        // the sink right after the Ping's first CountChanges(), so a
+        // baseline taken here sits after that check: any wake written
+        // later (including while the folder pool is being built, one
+        // connect/TLS/LOGIN/SELECT/IDLE after another) has a newer
+        // mtime and fires on the first wait(). Taking the baseline in
+        // wait() instead would swallow wakes written during pool build.
+        // A change that arrived before this Ping is still picked up:
+        // CheckForChanges() runs CountChanges() on the first iteration
+        // of every Ping.
+        clearstatcache(true, self::WAKE_FILE);
+        $baseline = @filemtime(self::WAKE_FILE);
+        $this->lastWakeMtime = ($baseline !== false) ? $baseline : 0;
     }
 
